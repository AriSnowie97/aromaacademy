APP_NAME=Аромакадемія
APP_ENV=development
DATABASE_URL=sqlite:///./aromaacademy.db
# For PostgreSQL + pgvector in Docker/prod:
# DATABASE_URL=postgresql+psycopg://aroma:aroma@postgres:5432/aromaacademy
SECRET_KEY=dev-change-this-secret-key-in-production
WEBHOOK_SECRET=dev-webhook-hmac-secret
# Aroma modes: "auto" (remote URL -> Gemini -> local), "remote", "gemini", "local"
AROMA_SERVICE_MODE=auto
AROMA_SERVICE_URL=
AROMA_SERVICE_TOKEN=
# Optional external LLM key if/when connected:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ANTHROPIC_API_KEY=

